<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Avalia Adventure | East Africa Safaris, Kilimanjaro & Zanzibar</title>

<meta name="description" content="Avalia Adventure is an East Africa DMC offering tailor-made safaris, Kilimanjaro trekking, Zanzibar holidays, honeymoon experiences and travel across Tanzania, Kenya, Uganda, Rwanda and Burundi.">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Arial, Helvetica, sans-serif;
    background:#fff;
    color:#171717;
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

img{
    max-width:100%;
    display:block;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

.topbar{
    background:#123524;
    color:#fff;
    font-size:12px;
    padding:8px 0;
}

.topbar .container{
    display:flex;
    justify-content:space-between;
    gap:15px;
}

header{
    position:sticky;
    top:0;
    z-index:999;
    background:#fff;
    border-bottom:1px solid #eee;
}

.nav{
    min-height:76px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
}

.logo-mark{
    width:44px;
    height:44px;
    border-radius:50%;
    background:#c9a227;
    color:#123524;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
}

.logo-text strong{
    display:block;
    color:#123524;
    letter-spacing:2px;
}

.logo-text span{
    display:block;
    font-size:10px;
    letter-spacing:3px;
}

.menu{
    display:flex;
    gap:20px;
    align-items:center;
    font-size:14px;
}

.menu a:hover{
    color:#b28b18;
}

.book-btn,
.btn{
    display:inline-block;
    padding:13px 22px;
    border-radius:3px;
    font-weight:bold;
    font-size:13px;
    letter-spacing:.5px;
}

.book-btn{
    background:#123524;
    color:#fff;
}

.btn-gold{
    background:#c9a227;
    color:#123524;
}

.btn-light{
    border:1px solid #fff;
    color:#fff;
}

.mobile-button{
    display:none;
    border:0;
    background:none;
    font-size:27px;
}

.hero{
    min-height:650px;
    display:flex;
    align-items:center;
    color:#fff;
    background:
        linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.18)),
        url("https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=2200&q=90")
        center/cover;
}

.hero-content{
    max-width:720px;
}

.eyebrow{
    display:inline-block;
    font-size:12px;
    letter-spacing:3px;
    font-weight:bold;
    margin-bottom:15px;
}

.hero h1{
    font-size:clamp(45px,7vw,82px);
    line-height:1.02;
    margin-bottom:20px;
}

.hero p{
    font-size:18px;
    max-width:650px;
    margin-bottom:30px;
}

.buttons{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.section{
    padding:90px 0;
}

.section.cream{
    background:#f5f1e7;
}

.section-title{
    max-width:700px;
    margin-bottom:45px;
}

.section-title h2{
    font-size:clamp(35px,5vw,58px);
    line-height:1.08;
    color:#123524;
}

.section-title p{
    margin-top:15px;
    color:#555;
}

.grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:24px;
}

.card{
    background:#fff;
    border:1px solid #e8e8e8;
    overflow:hidden;
}

.card-image{
    height:230px;
    background-size:cover;
    background-position:center;
}

.card-body{
    padding:25px;
}

.card-body span{
    font-size:11px;
    letter-spacing:2px;
    color:#987819;
    font-weight:bold;
}

.card-body h3{
    font-size:25px;
    color:#123524;
    margin:8px 0;
}

.card-body p{
    color:#555;
    margin-bottom:18px;
}

.card-body a{
    font-weight:bold;
    color:#123524;
    font-size:13px;
}

.tanzania{
    background-image:url("https://images.unsplash.com/photo-1516426122078-c23e76319801?auto=format&fit=crop&w=1200&q=85");
}

.kenya{
    background-image:url("https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=1200&q=85");
}

.uganda{
    background-image:url("https://images.unsplash.com/photo-1547471080-7cc2caa01a7e?auto=format&fit=crop&w=1200&q=85");
}

.rwanda{
    background-image:url("https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=1200&q=85");
}

.burundi{
    background-image:url("https://images.unsplash.com/photo-1500375592092-40eb2168fd21?auto=format&fit=crop&w=1200&q=85");
}

.zanzibar{
    background-image:url("https://images.unsplash.com/photo-1505881502353-a1986add3762?auto=format&fit=crop&w=1200&q=85");
}

.kili{
    background-image:url("https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=1200&q=85");
}

.experience{
    min-height:480px;
    display:flex;
    align-items:center;
    color:#fff;
    background:
        linear-gradient(rgba(4,30,20,.85),rgba(4,30,20,.85)),
        url("https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=2200&q=90")
        center/cover;
}

.experience h2{
    font-size:clamp(38px,6vw,65px);
    line-height:1.05;
    margin-bottom:20px;
}

.experience p{
    max-width:700px;
    margin-bottom:25px;
}

.kili-box{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:45px;
    align-items:center;
}

.price{
    font-size:35px;
    font-weight:bold;
    color:#c9a227;
    margin:20px 0;
}

.route{
    padding:25px;
    border-left:4px solid #c9a227;
    background:#f5f1e7;
    margin-bottom:15px;
}

.route h3{
    color:#123524;
}

.route strong{
    color:#987819;
}

.honeymoon{
    background:
        linear-gradient(rgba(18,53,36,.86),rgba(18,53,36,.86)),
        url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=2200&q=90")
        center/cover;
    color:#fff;
    padding:100px 0;
}

.honeymoon h2{
    font-size:clamp(40px,6vw,68px);
    line-height:1;
    margin-bottom:20px;
}

.honeymoon p{
    max-width:700px;
    margin-bottom:25px;
}

.honeymoon-list{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:30px;
}

.honeymoon-list span{
    border:1px solid rgba(255,255,255,.5);
    padding:9px 15px;
}

.b2b{
    background:#f5f1e7;
}

.b2b-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:50px;
    align-items:center;
}

.b2b h2{
    font-size:clamp(38px,5vw,60px);
    color:#123524;
    line-height:1.05;
}

.b2b p{
    color:#555;
    margin:20px 0;
}

.contact{
    padding:90px 0;
}

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1.2fr;
    gap:50px;
}

.contact h2{
    font-size:55px;
    color:#123524;
    line-height:1.05;
}

.contact-info{
    margin-top:30px;
}

.contact-info div{
    margin-bottom:18px;
}

.contact-info span{
    display:block;
    font-size:11px;
    letter-spacing:2px;
    color:#987819;
    font-weight:bold;
}

form{
    background:#f5f1e7;
    padding:35px;
}

.form-row{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:15px;
}

.form-group{
    margin-bottom:18px;
}

label{
    display:block;
    font-size:12px;
    font-weight:bold;
    margin-bottom:7px;
}

input,
select,
textarea{
    width:100%;
    padding:13px;
    border:1px solid #d5d5d5;
    background:#fff;
    font:inherit;
}

textarea{
    resize:vertical;
}

.form-submit{
    border:0;
    cursor:pointer;
    width:100%;
}

footer{
    background:#0d2419;
    color:#fff;
    padding:60px 0 20px;
}

.footer-grid{
    display:grid;
    grid-template-columns:2fr 1fr 1fr 1fr;
    gap:35px;
}

footer h4{
    color:#c9a227;
    margin-bottom:15px;
}

footer a{
    display:block;
    margin-bottom:8px;
    color:#ddd;
}

footer p{
    color:#bbb;
    max-width:350px;
}

.copyright{
    border-top:1px solid rgba(255,255,255,.15);
    margin-top:40px;
    padding-top:20px;
    display:flex;
    justify-content:space-between;
    color:#aaa;
    font-size:12px;
}

.mobile-menu{
    display:none;
}

@media(max-width:900px){

    .menu,
    header > .container > .book-btn{
        display:none;
    }

    .mobile-button{
        display:block;
    }

    .mobile-menu{
        display:none;
        position:absolute;
        top:76px;
        left:0;
        width:100%;
        background:#fff;
        border-top:1px solid #eee;
        padding:20px;
    }

    .mobile-menu.show{
        display:block;
    }

    .mobile-menu a{
        display:block;
        padding:13px 5%;
        border-bottom:1px solid #eee;
    }

    .grid,
    .kili-box,
    .b2b-grid,
    .contact-grid,
    .footer-grid{
        grid-template-columns:1fr;
    }

    .form-row{
        grid-template-columns:1fr;
    }

    .topbar .container{
        flex-direction:column;
        text-align:center;
    }

    .hero{
        min-height:600px;
    }

    .section{
        padding:65px 0;
    }

    .copyright{
        flex-direction:column;
        gap:10px;
    }
}

</style>
</head>


<body>


<!-- TOP BAR -->

<div class="topbar">

<div class="container">

<span>East Africa DMC</span>

<span>When Wild Calls Your Name</span>

<span>Tanzania • Kenya • Uganda • Rwanda • Burundi</span>

</div>

</div>



<!-- HEADER -->

<header>

<div class="container nav">

