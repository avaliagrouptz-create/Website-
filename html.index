<!-- KILIMANJARO -->

<section class="section" id="kilimanjaro">

<div class="container">

<div class="kili-box">

<div>

<span class="eyebrow">
MOUNT KILIMANJARO
</span>

<h2 style="font-size:55px;line-height:1.05;color:#123524;">
Reach the Roof<br>
of Africa.
</h2>

<p style="margin-top:20px;color:#555;">
Choose your route and climb Africa's highest
mountain with an experienced professional team.
</p>

<div class="price">
Starting From $2,000 Per Person
</div>

<a href="#contact" class="btn btn-gold">
BOOK KILIMANJARO
</a>

</div>


<div>

<div class="route">

<h3>Machame Route</h3>

<strong>7 Days / 6 Nights</strong>

<p>
Alpine tents • Scenic landscapes •
High success route.
</p>

</div>


<div class="route">

<h3>Marangu Route</h3>

<strong>6 Days / 5 Nights</strong>

<p>
Mountain huts • Classic route •
Comfortable trekking option.
</p>

</div>


<div class="route">

<h3>Lemosho Route</h3>

<strong>8 Days / 7 Nights</strong>

<p>
Alpine tents • Scenic western approach •
Excellent acclimatization.
</p>

</div>


<div class="route">

<h3>Rongai Route</h3>

<strong>7 Days</strong>

<p>
Quiet northern approach • Alpine tents •
Unique Kilimanjaro experience.
</p>

</div>

</div>

</div>

</div>

</section>



