<!-- HONEYMOON -->

<section class="honeymoon" id="honeymoon">

<div class="container">

<span class="eyebrow">
HONEYMOON COLLECTION
</span>

<h2>
Your love story.<br>
Our destination.
</h2>

<p>
Combine safari, Kilimanjaro and Zanzibar
